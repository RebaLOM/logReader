<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<AssemblyName>LOGER</AssemblyName>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>Resources\loger2.ico</ApplicationIcon>
		<Win32Icon>Resources\loger2.ico</Win32Icon>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\logger.ico" />
		<EmbeddedResource Include="Resources\loger2.ico" LogicalName="logReader.UI.Resources.loger2.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\logReader\logReader.csproj" />
		<InternalsVisibleTo Include="logReader.UI.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="logReader.Processing" />
	</ItemGroup>

</Project>
