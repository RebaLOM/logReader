<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<AssemblyName>LOGER</AssemblyName>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>Resources\logger.ico</ApplicationIcon>
		<Win32Icon>Resources\logger.ico</Win32Icon>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\logger.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\logReader\logReader.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="logReader.Processing" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="AntdUI" Version="2.4.12" />
	</ItemGroup>

</Project>
